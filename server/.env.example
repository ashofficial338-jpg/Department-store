# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database - MongoDB Atlas is the primary database. There is no automatic fallback to local MongoDB:
# if Atlas is unreachable the API returns a connection error.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/department_store?retryWrites=true&w=majority
# Folder (inside server/) where database backups are written.
BACKUP_DIR=backups

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
