# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database - use ONE of the following
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/department_store
# MongoDB Atlas (production/cloud) - uncomment and replace with your own connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/department_store?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
