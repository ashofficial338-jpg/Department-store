{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["bom1"],
  "installCommand": "npm ci --include=dev --prefix client && npm ci --prefix server",
  "buildCommand": "node scripts/verify.mjs",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
